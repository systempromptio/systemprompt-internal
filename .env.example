# At least one of these is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional — auto-generated on first boot if left blank.
JWT_SECRET=

# Required to link an Odoo account: per-user API keys are stored encrypted
# under this key, and without it the profile page's Odoo card cannot save one.
# 32 bytes, hex-encoded (64 characters): `openssl rand -hex 32`.
ENCRYPTION_MASTER_KEY=

# Odoo connection for the `odoo` MCP server and the profile linking flow.
# ODOO_URL is the base URL with no trailing slash; calls post to
# {ODOO_URL}/jsonrpc. ODOO_DB names the database, since one Odoo server can
# host several. No credential belongs here — every user links their own login
# and API key from /admin/profile, and every Odoo call runs as that user.
ODOO_URL=https://odoo.example.com
ODOO_DB=odoo

# Email domains eligible for passkey self-registration, comma-separated.
# This is the whole provisioning gate: anyone with an address in one of these
# domains can create an account. Leave blank for the shipped default.
SELF_REGISTRATION_EMAIL_DOMAINS=

# Optional — defaults shown.
HTTP_PORT=8080
PG_PORT=5432
POSTGRES_PASSWORD=systemprompt
