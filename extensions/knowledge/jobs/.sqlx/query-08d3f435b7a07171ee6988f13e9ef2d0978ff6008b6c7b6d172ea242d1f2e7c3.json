{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                title,\n                source,\n                project,\n                created_at,\n                char_length(content) AS \"size!\",\n                status,\n                category,\n                structured->>'summary' AS summary\n            FROM knowledge_documents\n            WHERE ($1::text IS NULL OR project = $1)\n              AND ($2::text IS NULL OR source = $2)\n              AND ($4::bool OR status = 'reference')\n            ORDER BY created_at DESC\n            LIMIT $3\n            ",
