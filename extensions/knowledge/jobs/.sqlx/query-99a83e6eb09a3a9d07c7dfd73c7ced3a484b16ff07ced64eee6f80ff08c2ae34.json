{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, title, content,\n               COALESCE((metadata->>'categorization_attempts')::int, 0) AS \"attempts!\"\n        FROM knowledge_documents\n        WHERE status = 'raw'\n          AND COALESCE((metadata->>'categorization_attempts')::int, 0) < $2\n        ORDER BY created_at\n        LIMIT $1\n        ",
