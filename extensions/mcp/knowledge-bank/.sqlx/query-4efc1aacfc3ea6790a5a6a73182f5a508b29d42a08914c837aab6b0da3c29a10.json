  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                title,\n                source,\n                project,\n                created_at,\n                uploaded_by,\n                left(content, $3) AS \"snippet!\"\n            FROM knowledge_documents\n            WHERE ($1::text IS NULL OR project = $1)\n            ORDER BY created_at DESC\n            LIMIT $2\n            ",
