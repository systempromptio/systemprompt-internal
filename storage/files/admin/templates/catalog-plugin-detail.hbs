{{#> layout title=title page=page}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "content"}}
    {{> components/back-button href="/admin/catalog/plugins" label="Plugins"}}

    <header class="page-header">
        <div class="page-header__title-group">
            <h1 class="page-header__title">{{name}}
                {{#if enabled}}<span class="badge badge-success">enabled</span>{{else}}<span class="badge badge-muted">disabled</span>{{/if}}
            </h1>
            {{#if description}}<p class="page-header__subtitle">{{description}}</p>{{/if}}
        </div>
        <div class="page-header__actions">
            <a class="btn btn-sm btn-outline" href="{{matrix_url}}">Access matrix →</a>
        </div>
    </header>

    <div class="catalog-meta-bar">
        {{#if category}}<span class="chip chip--tag">{{category}}</span>{{/if}}
        <span class="chip chip--muted">v{{version}}</span>
        {{#if author_name}}<span class="chip chip--muted">by {{author_name}}</span>{{/if}}
        <span class="chip chip--muted">{{assignment_count}} assignment{{#unless (eq assignment_count 1)}}s{{/unless}}</span>
        <code class="code-inline">{{source_path}}</code>
    </div>

    <div class="catalog-detail-grid">
        <section class="catalog-rel-section">
            <h2 class="catalog-rel-section__title">Skills <span class="count-pill">{{skills_count}}</span></h2>
            {{#if skills_count}}
            <ul class="rel-list">
                {{#each skills}}
                <li><a class="rel-link" href="{{url}}"><span class="rel-link__name">{{name}}</span><code class="code-inline">{{id}}</code></a></li>
                {{/each}}
            </ul>
            {{else}}<p class="text-tertiary">None</p>{{/if}}
        </section>

        <section class="catalog-rel-section">
            <h2 class="catalog-rel-section__title">MCP servers <span class="count-pill">{{mcp_count}}</span></h2>
            {{#if mcp_count}}
            <ul class="rel-list">
                {{#each mcp_servers}}
                <li><a class="rel-link" href="{{url}}"><span class="rel-link__name">{{name}}</span></a></li>
                {{/each}}
            </ul>
            {{else}}<p class="text-tertiary">None</p>{{/if}}
        </section>

        <section class="catalog-rel-section">
            <h2 class="catalog-rel-section__title">Agents <span class="count-pill">{{agents_count}}</span></h2>
            {{#if agents_count}}
            <ul class="rel-list">
                {{#each agents}}
                <li><span class="rel-link rel-link--static"><span class="rel-link__name">{{name}}</span><code class="code-inline">{{id}}</code></span></li>
                {{/each}}
            </ul>
            {{else}}<p class="text-tertiary">None</p>{{/if}}
        </section>

        <section class="catalog-rel-section">
            <h2 class="catalog-rel-section__title">Hooks <span class="count-pill">{{hooks_count}}</span></h2>
            {{#if hooks_count}}
            <ul class="rel-list">
                {{#each hooks}}
                <li class="rel-hook">
                    <span class="rel-link__name">{{event}}</span>
                    <code class="code-inline">{{matcher}}</code>
                    <span class="text-muted text-xs">{{command}}</span>
                    {{#if is_async}}<span class="badge badge-muted">async</span>{{/if}}
                </li>
                {{/each}}
            </ul>
            {{else}}<p class="text-tertiary">None</p>{{/if}}
        </section>
    </div>

    {{#if roles}}
    <div class="catalog-meta-bar">
        <span class="text-muted text-xs">Roles:</span>
        {{#each roles}}<span class="chip chip--muted">{{this}}</span>{{/each}}
    </div>
    {{/if}}
    {{#if keywords}}
    <div class="catalog-meta-bar">
        <span class="text-muted text-xs">Keywords:</span>
        {{#each keywords}}<span class="chip chip--tag">{{this}}</span>{{/each}}
    </div>
    {{/if}}
    {{/inline}}
{{/layout}}
