{{#> layout title=title page=page}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "content"}}
    {{> components/back-button href="/admin/enterprises" label="All enterprises"}}
    {{> components/page-header title=enterprise.name subtitle=enterprise.slug}}

    <section class="ent-summary card" aria-label="Contract">
        <div class="ent-summary__facts">
            <div class="ent-fact">
                <span class="ent-fact__label">Plan</span>
                <span class="ent-fact__value">{{#if enterprise.plan_name}}{{enterprise.plan_name}}{{else}}No plan{{/if}}</span>
            </div>
            <div class="ent-fact">
                <span class="ent-fact__label">Status</span>
                <span class="ent-fact__value">{{#if enterprise.is_active}}<span class="badge badge-success">Active</span>{{else}}<span class="badge badge-secondary">{{enterprise.status}}</span>{{/if}}</span>
            </div>
            <div class="ent-fact">
                <span class="ent-fact__label">Seats</span>
                <span class="ent-fact__value">{{enterprise.seats_used}}{{#if enterprise.has_seat_limit}} / {{enterprise.seat_limit}}{{else}} · unlimited{{/if}}</span>
            </div>
            <div class="ent-fact">
                <span class="ent-fact__label">Budget</span>
                <span class="ent-fact__value">{{#if enterprise.has_budget}}<span class="ent-pill ent-pill--{{enterprise.budget_state}}">{{enterprise.budget_pct}}%</span>{{else}}<span class="text-tertiary">uncapped</span>{{/if}}</span>
            </div>
        </div>
        <div class="ent-summary__pl">
            {{> components/stat-card label="Licence revenue" value=(formatUsd enterprise.revenue_microdollars) subtitle="billed this month"}}
            {{> components/stat-card label="Inference cost" value=(formatUsd enterprise.cost_mtd_microdollars) subtitle="month to date"}}
            {{> components/stat-card label="Margin" value=(formatUsd enterprise.margin_microdollars) variant=margin_variant subtitle="revenue less cost"}}
            {{> components/stat-card label="Cost 30d" value=(formatUsd enterprise.cost_30d_microdollars) subtitle=(concat (formatNumber enterprise.requests_30d) " requests")}}
        </div>
    </section>

    <section aria-label="Members" class="card ent-section">
        <h2>Users <span class="ent-count">{{enterprise.seats_used}} active</span></h2>
        {{#if members}}
        {{#> components/data-table}}
            <thead><tr>
                <th>User</th>
                <th>Role in enterprise</th>
                <th>Department</th>
                <th class="col-status">Status</th>
            </tr></thead>
            <tbody>
            {{#each members}}
                <tr>
                    <td>
                        <a href="/admin/user/?id={{user_id}}" class="user-cell">
                            <span class="avatar avatar-sm">{{initials (default display_name email)}}</span>
                            <span class="user-cell-text">
                                <span class="user-cell-name">{{default display_name email}}</span>
                                <span class="user-cell-email">{{email}}</span>
                            </span>
                        </a>
                    </td>
                    <td><span class="badge badge-gray">{{org_role}}</span></td>
                    <td>{{#if department}}{{department}}{{else}}<span class="text-tertiary">—</span>{{/if}}</td>
                    <td class="col-status">{{#if is_active}}<span class="badge badge-success">Active</span>{{else}}<span class="badge badge-secondary">Inactive</span>{{/if}}</td>
                </tr>
            {{/each}}
            </tbody>
        {{/components/data-table}}
        {{else}}
        {{> components/empty-state message="Nobody has joined this enterprise yet."}}
        {{/if}}
    </section>

    <section aria-label="Departments" class="card ent-section">
        <h2>Departments <span class="ent-count">{{enterprise.departments}}</span></h2>
        {{#if departments}}
        {{#> components/data-table}}
            <thead><tr><th>Department</th><th>Description</th><th class="numeric col-numeric">Members</th></tr></thead>
            <tbody>
            {{#each departments}}
                <tr>
                    <td><a href="/admin/access/departments/{{id}}">{{name}}</a></td>
                    <td>{{#if description}}{{description}}{{else}}<span class="text-tertiary">—</span>{{/if}}</td>
                    <td class="numeric">{{member_count}}</td>
                </tr>
            {{/each}}
            </tbody>
        {{/components/data-table}}
        {{else}}
        {{> components/empty-state message="No departments in this enterprise."}}
        {{/if}}
    </section>

    <section aria-label="Entitlements" class="card ent-section">
        <h2>Entitlements <span class="ent-count">{{enterprise.entitlements}} granted</span></h2>
        <p class="text-muted">Read-only. These rules are projected from the plan in <code class="code-inline">services/access-control/plans.yaml</code> and are what the resolver reads at enforcement time. A department or user rule can narrow them; nothing here can widen them.</p>
        {{#if entitlements}}
        {{#> components/data-table}}
            <thead><tr><th>Type</th><th>Entity</th><th class="col-status">Access</th></tr></thead>
            <tbody>
            {{#each entitlements}}
                <tr>
                    <td><span class="badge badge-gray">{{entity_type}}</span></td>
                    <td><code class="code-inline">{{entity_id}}</code></td>
                    <td class="col-status">{{#if allowed}}<span class="badge badge-success">allow</span>{{else}}<span class="badge badge-danger">deny</span>{{/if}}</td>
                </tr>
            {{/each}}
            </tbody>
        {{/components/data-table}}
        {{else}}
        {{> components/empty-state message="This enterprise's plan grants nothing yet."}}
        {{/if}}
    </section>

    <section aria-label="Usage" class="card ent-section">
        <h2>Model usage <span class="ent-count">last 30 days</span></h2>
        {{#if models}}
        {{#> components/data-table}}
            <thead><tr>
                <th>Model</th>
                <th class="numeric col-numeric">Requests</th>
                <th class="numeric col-numeric">Tokens</th>
                <th class="numeric col-numeric">Cost</th>
                <th>Share of spend</th>
            </tr></thead>
            <tbody>
            {{#each models}}
                <tr>
                    <td><code class="code-inline">{{model}}</code></td>
                    <td class="numeric">{{formatNumber requests}}</td>
                    <td class="numeric">{{formatNumber tokens}}</td>
                    <td class="numeric">{{formatUsd cost_microdollars}}</td>
                    <td><span class="ent-bar ent-bar--wide" style="--ent-bar-pct:{{share_pct}}%"><span class="ent-bar__fill"></span></span></td>
                </tr>
            {{/each}}
            </tbody>
        {{/components/data-table}}
        {{else}}
        {{> components/empty-state message="No gateway traffic from this enterprise in the last 30 days."}}
        {{/if}}
    </section>
    {{/inline}}
{{/layout}}
