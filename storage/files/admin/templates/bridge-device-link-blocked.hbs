<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <title>{{branding.domain}} — Cannot authorise device</title>
    <link rel="stylesheet" href="/css/core/fonts.css?v={{css_version}}">
    <link rel="stylesheet" href="/css/admin-bundle.css?v={{css_version}}">
</head>
<body>
    <div class="sp-login-container">
        <div class="sp-card">
            <div class="sp-login-logo"><img src="/files/images/logo-white.svg" alt="{{branding.domain}}" height="40"></div>
            <h1 class="sp-u-text-lg">Cannot authorise this device</h1>
            <p class="sp-u-text-sm sp-u-text-tertiary sp-u-mt-3">{{blocked_reason}}</p>
            <p class="sp-u-text-sm sp-u-text-tertiary sp-u-mt-3">
                Nothing was issued and nothing was granted.
            </p>
            <a class="sp-btn sp-btn--primary sp-u-w-full" href="{{switch_account_href}}">Sign in again</a>
        </div>
    </div>
</body>
</html>
