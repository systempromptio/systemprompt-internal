<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <title>{{branding.domain}} — Cannot authorise device</title>
    <link rel="stylesheet" href="/css/core/fonts.css?v={{css_version}}">
    <link rel="stylesheet" href="/css/admin-bundle.css?v={{css_version}}">
</head>
<body>
    <div class="login-container">
        <div class="card">
            <div class="login-logo"><img src="/files/images/logo-white.svg" alt="{{branding.domain}}" height="40"></div>
            <h1 class="text-xl mb-2">Cannot authorise this device</h1>
            <p class="text-sm text-tertiary mb-3">{{blocked_reason}}</p>
            <p class="text-sm text-tertiary mb-4">
                Nothing was issued and nothing was granted.
            </p>
            <a class="btn btn-primary w-full" href="{{switch_account_href}}">Sign in again</a>
        </div>
    </div>
</body>
</html>
