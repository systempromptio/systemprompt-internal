{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/page-header title=title subtitle=subtitle}}

    <section class="sp-kpi-grid" aria-label="Demo KPIs">
        {{#each kpis}}
        {{> components/stat-card label=label value=value variant=variant testid=testid}}
        {{/each}}
    </section>

    {{> components/timeseries-chart chart}}

    <section aria-label="MCP servers">
        {{#if has_servers}}
        <div class="sp-demo-scenarios">
            {{#each servers}}
            <div class="sp-demo-scenario sp-demo-scenario--accent">
                <span class="sp-demo-scenario__body">
                    <span class="sp-demo-scenario__heading">{{server}}</span>
                    <span class="sp-demo-scenario__description">
                        {{formatNumber tool_count}} tools · {{formatNumber failure_count}} failed ·
                        {{formatNumber denied}} denied · {{formatNumber held}} held · {{cost_display}}
                    </span>
                </span>
                <span class="sp-demo-scenario__count">{{formatNumber call_count}}</span>
            </div>
            {{/each}}
        </div>
        {{/if}}
    </section>

    <section aria-label="MCP tools">
        {{#if has_tools}}
        {{#> components/data-table}}
            <thead><tr>
                <th>Server</th>
                <th>Tool</th>
                <th class="sp-u-num sp-table__cell--num">Calls</th>
                <th class="sp-u-num sp-table__cell--num">Failed</th>
                <th class="sp-u-num sp-table__cell--num">Failure rate</th>
                <th class="sp-u-num sp-table__cell--num">Users</th>
                <th class="sp-u-num sp-table__cell--num">Allowed</th>
                <th class="sp-u-num sp-table__cell--num">Denied</th>
                <th class="sp-u-num sp-table__cell--num">Held</th>
                <th class="sp-u-num sp-table__cell--num">Approved</th>
                <th class="sp-u-num sp-table__cell--num">Rejected</th>
                <th class="sp-u-num sp-table__cell--num">Pending</th>
                <th class="sp-u-num sp-table__cell--num">Tokens</th>
                <th class="sp-u-num sp-table__cell--num">Cost</th>
                <th class="sp-col-date">Last used</th>
            </tr></thead>
            <tbody>
            {{#each tools}}
            <tr>
                <td><span class="sp-badge sp-badge--muted">{{server}}</span></td>
                <td><code class="sp-code-inline">{{tool}}</code></td>
                <td class="sp-u-num">{{formatNumber call_count}}</td>
                <td class="sp-u-num">{{formatNumber failure_count}}</td>
                <td class="sp-u-num">{{failure_rate_display}}</td>
                <td class="sp-u-num">{{formatNumber distinct_users}}</td>
                <td class="sp-u-num">{{formatNumber allowed}}</td>
                <td class="sp-u-num">{{formatNumber denied}}</td>
                <td class="sp-u-num">{{formatNumber held}}</td>
                <td class="sp-u-num">{{formatNumber approved}}</td>
                <td class="sp-u-num">{{formatNumber rejected}}</td>
                <td class="sp-u-num">{{formatNumber approval_pending}}</td>
                <td class="sp-u-num">{{tokens_display}}</td>
                <td class="sp-u-num">{{cost_display}}</td>
                <td class="sp-col-date">
                    {{#if last_used_at}}<span title="{{formatDate last_used_at}}">{{relativeTime last_used_at}}</span>
                    {{else}}<span class="sp-u-text-tertiary">Never</span>{{/if}}
                </td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/data-table}}
        {{else}}
        {{> components/empty-state message="No MCP tool calls recorded yet."}}
        {{/if}}
    </section>

    <section aria-label="Users by tool">
        <h2 class="sp-section__title">Who called what</h2>
        {{#if matrix.has_data}}
        <div class="sp-demo-matrix">
            <table class="sp-demo-matrix__table">
                <thead><tr>
                    <th scope="col">User</th>
                    {{#each matrix.columns}}<th scope="col" title="{{this.full}}">{{this.label}}</th>{{/each}}
                    <th scope="col" class="sp-u-num">Total</th>
                </tr></thead>
                <tbody>
                {{#each matrix.rows}}
                <tr>
                    <th scope="row">{{user_email}}</th>
                    {{#each cells}}
                    <td class="sp-demo-matrix__cell{{#if is_zero}} sp-demo-matrix__cell--empty{{/if}}" style="--v:{{pct}}%">{{count}}</td>
                    {{/each}}
                    <td class="sp-u-num">{{formatNumber total}}</td>
                </tr>
                {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        {{> components/empty-state message="No per-user MCP tool activity in this window."}}
        {{/if}}
        <p class="sp-u-text-tertiary sp-u-text-xs sp-u-mt-3">{{attribution_note}}</p>
    </section>
    {{/inline}}
{{/layout}}
