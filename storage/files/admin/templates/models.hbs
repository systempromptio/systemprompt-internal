{{#> layout title=title page=page}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "content"}}
    {{> components/page-header title=title subtitle="Enable or disable gateway models per user and watch the governed traffic they generate. Powers the Pi coding-agent demo (examples/pi/)."}}

    <div class="toolbar" role="toolbar" aria-label="User selection">
        <form method="get" action="/admin/models" class="search-group" id="model-user-form">
            <label for="model-user-select" class="text-tertiary" style="align-self:center; margin-right:0.5rem;">User</label>
            <select id="model-user-select" name="user_id" class="search-input" onchange="this.form.submit()">
                <option value="">Select a user&hellip;</option>
                {{#each users}}
                <option value="{{id}}"{{#if selected}} selected{{/if}}>{{label}}</option>
                {{/each}}
            </select>
        </form>
        <a class="btn" href="{{requests_link}}">Open request traces &rarr;</a>
    </div>

    <section aria-label="Model availability" data-page="models" data-user-id="{{selected_user_id}}">
    {{#> components/data-table}}
        <thead><tr>
            <th>Model</th>
            <th>Provider</th>
            <th>Route</th>
            <th>Upstream</th>
            <th class="col-status">Status</th>
            <th class="col-actions">{{#if has_selection}}Access for {{selected_user_label}}{{/if}}</th>
        </tr></thead>
        <tbody>
        {{#each models}}
        <tr data-route-id="{{route_id}}">
            <td><code>{{model_pattern}}</code></td>
            <td><span class="badge badge-gray">{{provider}}</span></td>
            <td><code>{{route_id}}</code></td>
            <td>{{upstream_model}}</td>
            <td class="col-status">
                {{#if denied}}<span class="badge badge-red">{{status_label}}</span>{{else}}<span class="badge badge-green">{{status_label}}</span>{{/if}}
            </td>
            <td class="col-actions">
                {{#if ../has_selection}}
                {{#if denied}}
                <button type="button" class="btn btn-sm" data-action="enable-model" data-route-id="{{route_id}}" data-rule-id="{{deny_rule_id}}">Enable</button>
                {{else}}
                <button type="button" class="btn btn-sm btn-danger" data-action="disable-model" data-route-id="{{route_id}}">Disable</button>
                {{/if}}
                {{else}}
                <span class="text-tertiary">Select a user to manage access</span>
                {{/if}}
            </td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/data-table}}
    </section>

    {{#if has_selection}}
    <section aria-label="User usage">
        <header class="page-header">
            <div class="page-header__title-group">
                <h1 class="page-header__title">Usage &mdash; {{selected_user_label}}</h1>
                <p class="page-header__subtitle">Every /v1/messages call this user made (last 24h, newest first). Denied and failed calls are audited the same as completed ones.</p>
            </div>
        </header>

        <div class="stats-row">
            {{> components/stat-card value=usage_totals.requests label="Requests"}}
            {{> components/stat-card value=usage_totals.input_tokens label="Tokens in"}}
            {{> components/stat-card value=usage_totals.output_tokens label="Tokens out"}}
            {{> components/stat-card value=usage_totals.cost label="Cost"}}
            {{> components/stat-card value=usage_totals.denied_requests label="Not completed"}}
        </div>

        {{#if has_usage}}
        {{#> components/data-table}}
            <thead><tr>
                <th class="col-date">Time (UTC)</th>
                <th>Model</th>
                <th>Provider</th>
                <th class="col-status">Status</th>
                <th class="numeric col-numeric">Tokens in/out</th>
                <th class="numeric col-numeric">Cost</th>
                <th class="numeric col-numeric">Latency</th>
                <th class="numeric col-numeric">Denials</th>
            </tr></thead>
            <tbody>
            {{#each usage}}
            <tr>
                <td class="col-date">{{created_at}}</td>
                <td><code>{{model}}</code></td>
                <td><span class="badge badge-gray">{{provider}}</span></td>
                <td class="col-status">
                    {{#if is_completed}}<span class="badge badge-green">{{status}}</span>{{else}}<span class="badge badge-red">{{status}}</span>{{/if}}
                </td>
                <td class="numeric col-numeric">{{tokens}}</td>
                <td class="numeric col-numeric">{{cost}}</td>
                <td class="numeric col-numeric">{{latency_ms}}ms</td>
                <td class="numeric col-numeric">{{deny_count}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/data-table}}
        {{else}}
        {{> components/empty-state title="No requests yet" message="Drive a request through the gateway (e.g. the Pi coding agent) and it will appear here."}}
        {{/if}}
    </section>
    {{/if}}
    {{/inline}}
    {{#*inline "scripts"}}
    <script type="module" src="/js/pages/admin-models.js"></script>
    {{/inline}}
{{/layout}}
