{{#> layout title=title page=page}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "content"}}
    {{> components/back-button href="/admin/catalog/mcp" label="MCP servers"}}

    <header class="page-header">
        <div class="page-header__title-group">
            <h1 class="page-header__title"><code class="code-inline">{{id}}</code>
                {{#if enabled}}<span class="badge badge-success">enabled</span>{{else}}<span class="badge badge-muted">disabled</span>{{/if}}
            </h1>
            {{#if description}}<p class="page-header__subtitle">{{description}}</p>{{/if}}
        </div>
        <div class="page-header__actions">
            <a class="btn btn-sm btn-outline" href="{{matrix_url}}">Access matrix →</a>
        </div>
    </header>

    <div class="catalog-meta-bar">
        <span class="chip chip--muted">{{server_type}}</span>
        {{#if oauth_required}}<span class="badge badge-warning">OAuth required</span>{{/if}}
        <span class="chip chip--muted">{{assignment_count}} assignment{{#unless (eq assignment_count 1)}}s{{/unless}}</span>
        <code class="code-inline">{{source_path}}</code>
    </div>

    <div class="catalog-detail-grid">
        <section class="catalog-rel-section">
            <h2 class="catalog-rel-section__title">Endpoint</h2>
            <dl class="kv-list">
                <div class="kv-row"><dt>Endpoint</dt><dd><code class="code-inline">{{#if endpoint}}{{endpoint}}{{else}}—{{/if}}</code></dd></div>
                <div class="kv-row"><dt>Port</dt><dd>{{#if port}}{{port}}{{else}}—{{/if}}</dd></div>
                {{#if oauth_required}}
                <div class="kv-row"><dt>Audience</dt><dd><code class="code-inline">{{oauth_audience}}</code></dd></div>
                <div class="kv-row"><dt>Scopes</dt><dd>{{#each oauth_scopes}}<span class="chip chip--tag">{{this}}</span>{{else}}—{{/each}}</dd></div>
                {{/if}}
            </dl>
        </section>

        <section class="catalog-rel-section">
            <h2 class="catalog-rel-section__title">Included by plugins <span class="count-pill">{{included_by_count}}</span></h2>
            {{#if included_by_count}}
            <ul class="rel-list">
                {{#each included_by}}
                <li><a class="rel-link" href="{{url}}"><span class="rel-link__name">{{name}}</span><code class="code-inline">{{id}}</code></a></li>
                {{/each}}
            </ul>
            {{else}}<p class="text-tertiary">Not bundled in any plugin. Assign directly through the access matrix.</p>{{/if}}
        </section>
    </div>
    {{/inline}}
{{/layout}}
