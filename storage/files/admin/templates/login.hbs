<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <title>{{branding.domain}} - Sign In</title>
    <link rel="stylesheet" href="/css/core/fonts.css?v={{css_version}}">
    <link rel="stylesheet" href="/css/admin-bundle.css?v={{css_version}}">
</head>
<body>
    <main class="auth-page">
        <div class="auth-card">
            <div class="login-logo">
                <img src="/files/images/logo-white.svg" alt="{{branding.domain}}" height="36">
            </div>

            <h1 class="auth-title">Sign in</h1>
            <p class="auth-subtitle">Continue with your Odoo account</p>

            <div id="error" class="login-error" role="alert" aria-live="polite" hidden></div>

            <form id="odoo-login-form" class="auth-form" novalidate>
                <div class="form-group">
                    <label for="odoo-login">Email</label>
                    <input class="form-input" type="email" id="odoo-login" name="login"
                           placeholder="you@systemprompt.io" autocomplete="username"
                           autocapitalize="none" spellcheck="false" required
                           aria-describedby="error">
                </div>

                <div class="form-group">
                    <label for="odoo-credential">Password or API key</label>
                    <input class="form-input" type="password" id="odoo-credential" name="credential"
                           autocomplete="current-password" required aria-describedby="error">
                </div>

                <button type="submit" id="odoo-sign-in-btn" class="btn btn-primary w-full">Sign in</button>
            </form>

            <div id="loading" class="login-loading" hidden aria-live="polite">
                <div class="login-spinner" role="status" aria-label="Signing in"></div>
                <p id="loading-text">Signing in…</p>
            </div>

            {{#if passkey_authorize_url}}
            <p class="auth-alt"><a href="{{passkey_authorize_url}}">Use a passkey instead</a></p>
            {{/if}}
            <p class="auth-alt"><a href="/admin/login/operator">Operator sign-in</a></p>
        </div>
    </main>

    <script data-cfasync="false" src="/js/services/odoo-login.js?v=4" type="module"></script>
</body>
</html>
