{{#> layout}}
    {{#*inline "approval-card"}}
      <article class="sp-approval-card{{#if this.is_ingestion}} sp-approval-card--ingestion{{/if}}">
        <header class="sp-approval-card__header">
          <div class="sp-approval-card__title">
            {{#if this.ingest}}
              <span class="sp-approval-card__subject">{{this.ingest.subject}}</span>
              {{> components/badge color="info" text="proposal"}}
            {{else}}
              <code class="sp-code-inline">{{this.tool_name}}</code>
              {{> components/badge color="warning" text="held"}}
            {{/if}}
          </div>
          {{#if this.ingest}}
          <p class="sp-approval-card__meta">
            From <strong>{{this.ingest.sender}}</strong>
            · proposed by the brain@ pipeline as <code class="sp-code-inline">{{this.requested_by}}</code>
            · document <code class="sp-code-inline">{{this.ingest.document_id}}</code>
          </p>
          {{else}}
          <p class="sp-approval-card__meta">
            Requested by <strong>{{this.requested_by}}</strong>
            on <code class="sp-code-inline">{{this.server_name}}</code>
            · matched rule <code class="sp-code-inline">{{this.rule}}</code>
          </p>
          {{/if}}
          <p class="sp-approval-card__meta">
            Waiting {{this.waiting_human}} · expires in {{this.expires_in_human}}
            {{#if this.trace_id}}
            · trace <code class="sp-code-inline">{{this.trace_id}}</code>
            {{/if}}
          </p>
        </header>

        {{#if this.ingest}}
        <ul class="sp-approval-card__summary">
          {{#each this.ingest.actions}}
          <li>{{this}}</li>
          {{/each}}
        </ul>
        {{/if}}

        {{!-- The exact payload that will run, not a summary of it: approving a
              description of a call is not approving the call. --}}
        <details class="sp-approval-card__args"{{#unless this.ingest}} open{{/unless}}>
          <summary>Arguments</summary>
          <pre class="sp-code-block"><code>{{this.arguments}}</code></pre>
        </details>

        <footer class="sp-approval-card__actions">
          <form method="post" action="{{this.approve_url}}">
            <button type="submit" class="sp-btn sp-btn--primary">Approve</button>
          </form>
          <form method="post" action="{{this.deny_url}}">
            <button type="submit" class="sp-btn sp-btn--danger">Deny</button>
          </form>
        </footer>
      </article>
    {{/inline}}
    {{#*inline "content"}}
    {{> components/page-header
        title="Pending approvals"
        subtitle="Tool calls held by the require_approval policy, and inbound emails the brain@ pipeline proposes to project into Odoo. Approving a held call resumes it; approving a proposal writes to Odoo as you within a minute."}}

    <p><a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/governance/approvals">All approvals and decision history</a></p>

    {{#if is_empty}}
      {{> components/empty-state message="Nothing is waiting. Held calls appear here the moment a governed tool call matches an approval rule; ingestion proposals appear on the hour after brain@ receives an email."}}
    {{else}}
    {{#if has_live}}
    <section class="sp-approvals" aria-label="Calls awaiting approval">
      <h2 class="sp-approvals__heading">Live tool calls <span class="sp-approvals__count">{{live_count}}</span></h2>
      <p class="sp-approvals__lede">Each one is a request blocked on this page right now.</p>
      {{#each live}}{{> approval-card}}{{/each}}
    </section>
    {{/if}}
    {{#if has_ingestion}}
    <section class="sp-approvals sp-approvals--ingestion" aria-label="Ingestion proposals awaiting approval">
      <h2 class="sp-approvals__heading">brain@ → Odoo proposals <span class="sp-approvals__count">{{ingestion_count}}</span></h2>
      <p class="sp-approvals__lede">Nobody is blocked on these. Approve and the <code class="sp-code-inline">knowledge_odoo_apply</code> job writes the actions to Odoo as your linked account; the Knowledge Feed dashboard shows the result. To untick individual actions, decide from the Approve Ingestion dashboard instead.</p>
      {{#each ingestion}}{{> approval-card}}{{/each}}
    </section>
    {{/if}}
    {{/if}}
    {{/inline}}
{{/layout}}
