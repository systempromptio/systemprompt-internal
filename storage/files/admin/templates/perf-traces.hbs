{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/page-header
        title="Trace Explorer"
        subtitle="Every gateway call, governance decision, and tool invocation grouped into a trace. Click any row to see the full waterfall."}}


    {{> components/time-range time_range}}
    {{> components/identity-filter-ribbon filter_ribbon}}

    <section class="stat-grid" aria-label="Trace summary">
      {{> components/stat-card label="Traces" value=stats.total_traces
          subtitle="in window"}}
      {{> components/stat-card label="Denied" value=stats.deny_count variant="danger"
          href=stats.deny_url active=stats.deny_active
          subtitle="traces with a deny"
          hint="Show only traces containing a denied decision"}}
      {{> components/stat-card label="Errors" value=stats.error_count variant="warning"
          href=stats.error_url active=stats.error_active
          subtitle="traces with a failure"
          hint="Show only traces containing a failed request"}}
      {{> components/stat-card label="Cost" value=stats.cost_display
          subtitle="billed in window"}}
      {{> components/stat-card label="Tokens" value=stats.tokens_display
          subtitle="total in / out"}}
      {{> components/stat-card label="p95 active" value=stats.p95_display
          subtitle=(concat "p50 " stats.p50_display " · p99 " stats.p99_display)
          hint="Percentiles over request latency, across traces that issued at least one request"}}
    </section>

    {{#if has_traces}}
      <div class="table-container">
        <div class="table-scroll">
          <table class="data-table trace-table">
            <thead><tr>
              {{> components/sort-header sort_headers.started}}
              <th class="col-trace">Trace</th>
              <th class="col-identity">Identity</th>
              <th class="col-model">Model</th>
              {{> components/sort-header sort_headers.activity}}
              {{> components/sort-header sort_headers.tokens}}
              {{> components/sort-header sort_headers.cost}}
              {{> components/sort-header sort_headers.duration}}
              <th class="col-status">Status</th>
            </tr></thead>
            <tbody>
            {{#each traces}}
            <tr class="trace-row">
              <td class="col-started">
                <div class="cell-stacked">
                  <span class="cell-primary" title="{{this.started_at}}">{{this.started_at_time}}</span>
                  <span class="cell-secondary">{{this.started_at_day}}</span>
                </div>
              </td>
              <td class="col-trace">
                <div class="cell-stacked">
                  <a href="{{this.detail_url}}" class="trace-row__id" title="{{this.session_id}}">
                    <code class="code-inline">{{this.session_id_short}}</code>
                  </a>
                  {{#if this.trace_id_short}}
                    <span class="cell-secondary" title="{{this.trace_id}}">trace {{this.trace_id_short}}</span>
                  {{/if}}
                </div>
              </td>
              <td class="col-identity">
                <div class="cell-stacked">
                  <span class="cell-primary" title="{{this.user_id}}">{{this.user_label}}</span>
                  {{#if this.agent_id}}
                    <span class="cell-secondary">{{this.agent_id}}{{#if this.agent_scope}} · {{this.agent_scope}}{{/if}}</span>
                  {{/if}}
                </div>
              </td>
              <td class="col-model">
                {{#if this.model_short}}
                  <div class="cell-stacked">
                    <span class="cell-primary" title="{{this.model}}">{{this.model_short}}</span>
                    {{#if this.provider}}<span class="cell-secondary">{{this.provider}}</span>{{/if}}
                  </div>
                {{else}}<span class="cell-muted">—</span>{{/if}}
              </td>
              <td class="col-spans">
                <div class="cell-stacked">
                  <span class="cell-primary">{{this.activity_display}}</span>
                  {{#if this.governance_display}}
                    <span class="cell-secondary" title="Governance decisions · tool calls">{{this.governance_display}}</span>
                  {{/if}}
                </div>
              </td>
              <td class="col-tokens">
                <div class="cell-stacked">
                  <span class="cell-primary">{{this.tokens_display}}</span>
                  {{#if this.tokens_split_display}}
                    <span class="cell-secondary">{{this.tokens_split_display}}</span>
                  {{/if}}
                </div>
              </td>
              <td class="col-cost">{{this.cost_display}}</td>
              <td class="col-duration">
                <div class="cell-stacked">
                  <span class="cell-primary" title="Summed request latency — the work this trace did">{{this.active_display}}</span>
                  <span class="cell-secondary" title="First-to-last event on this session id">{{this.window_display}} window</span>
                </div>
              </td>
              <td class="col-status">
                <div class="trace-row__badges">
                  {{#if this.has_deny}}<span class="mcp-badge mcp-badge-danger" title="{{this.deny_count}} denied decision(s)">DENY {{this.deny_count}}</span>{{/if}}
                  {{#if this.has_error}}<span class="mcp-badge mcp-badge-warning">ERROR</span>{{/if}}
                  {{#unless this.has_deny}}{{#unless this.has_error}}<span class="mcp-badge mcp-badge-success">OK</span>{{/unless}}{{/unless}}
                  {{#if this.cache_hit_any}}<span class="mcp-badge" title="Served partly from prompt cache">CACHE</span>{{/if}}
                </div>
              </td>
            </tr>
            {{/each}}
            </tbody>
          </table>
        </div>
        {{> components/pagination pagination}}
      </div>
    {{else}}
      {{> components/empty-state message="No traces in the selected window. Adjust the time range or filters."}}
    {{/if}}
    {{/inline}}
{{/layout}}
