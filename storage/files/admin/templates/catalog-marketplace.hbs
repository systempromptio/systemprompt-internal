{{#> layout title=title page=page}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "content"}}
    {{> components/page-header title=title subtitle="Skills, plugins, and MCP servers available to this workspace. Open any item to see who has access."}}

    <div class="toolbar" role="toolbar" aria-label="Marketplace filters">
        <div class="search-group">
            <input type="text" class="search-input" placeholder="Search marketplace…" id="catalog-search" aria-label="Search marketplace">
        </div>
        <div class="filter-chips" role="group" aria-label="Filter by type">
            <button type="button" class="chip active" data-filter="all">All ({{total}})</button>
            {{#if skills_count}}<button type="button" class="chip" data-filter="skill">Skills ({{skills_count}})</button>{{/if}}
            {{#if plugins_count}}<button type="button" class="chip" data-filter="plugin">Plugins ({{plugins_count}})</button>{{/if}}
            {{#if mcp_servers_count}}<button type="button" class="chip" data-filter="mcp_server">MCP servers ({{mcp_servers_count}})</button>{{/if}}
        </div>
    </div>

    {{#if total}}
    <div class="catalog-grid" id="catalog-grid">
        {{#each skills}}
        <article class="catalog-card" data-type="skill" data-search="skill {{toLowerCase name}} {{toLowerCase id}} {{toLowerCase source_path}}">
            <header class="catalog-card__head">
                <span class="badge">skill</span>
                {{#if enabled}}<span class="badge badge-success">enabled</span>{{else}}<span class="badge badge-muted">disabled</span>{{/if}}
            </header>
            <h3 class="catalog-card__name" title="{{id}} · {{source_path}}">{{name}}</h3>
            <code class="catalog-card__id">{{id}}</code>
            {{#if description}}<p class="catalog-card__desc">{{description}}</p>{{/if}}
            <footer class="catalog-card__foot">
                <a class="catalog-card__assignments" href="{{matrix_url}}" title="Departments and users with access">{{assignment_count}} assignment{{#unless (eq assignment_count 1)}}s{{/unless}}</a>
                <a class="btn btn-sm btn-outline" href="{{matrix_url}}">Access →</a>
            </footer>
        </article>
        {{/each}}
        {{#each plugins}}
        <article class="catalog-card" data-type="plugin" data-search="plugin {{toLowerCase name}} {{toLowerCase id}} {{toLowerCase source_path}}">
            <header class="catalog-card__head">
                <span class="badge">plugin</span>
                {{#if enabled}}<span class="badge badge-success">enabled</span>{{else}}<span class="badge badge-muted">disabled</span>{{/if}}
            </header>
            <h3 class="catalog-card__name" title="{{id}} · {{source_path}}">{{name}}</h3>
            <code class="catalog-card__id">{{id}}</code>
            {{#if description}}<p class="catalog-card__desc">{{description}}</p>{{/if}}
            <footer class="catalog-card__foot">
                <a class="catalog-card__assignments" href="{{matrix_url}}" title="Departments and users with access">{{assignment_count}} assignment{{#unless (eq assignment_count 1)}}s{{/unless}}</a>
                <a class="btn btn-sm btn-outline" href="{{matrix_url}}">Access →</a>
            </footer>
        </article>
        {{/each}}
        {{#each mcp_servers}}
        <article class="catalog-card" data-type="mcp_server" data-search="mcp_server {{toLowerCase name}} {{toLowerCase id}} {{toLowerCase source_path}}">
            <header class="catalog-card__head">
                <span class="badge">mcp server</span>
                {{#if enabled}}<span class="badge badge-success">enabled</span>{{else}}<span class="badge badge-muted">disabled</span>{{/if}}
            </header>
            <h3 class="catalog-card__name" title="{{id}} · {{source_path}}">{{name}}</h3>
            <code class="catalog-card__id">{{id}}</code>
            {{#if description}}<p class="catalog-card__desc">{{description}}</p>{{/if}}
            <footer class="catalog-card__foot">
                <a class="catalog-card__assignments" href="{{matrix_url}}" title="Departments and users with access">{{assignment_count}} assignment{{#unless (eq assignment_count 1)}}s{{/unless}}</a>
                <a class="btn btn-sm btn-outline" href="{{matrix_url}}">Access →</a>
            </footer>
        </article>
        {{/each}}
    </div>
    {{else}}
    <div class="empty-state" style="padding:3rem;text-align:center;">
        <h3>Marketplace is empty</h3>
        <p class="text-muted">No skills, plugins, or MCP servers configured yet.</p>
    </div>
    {{/if}}

    <script>
    (function(){
      const search = document.getElementById('catalog-search');
      const chips = document.querySelectorAll('.filter-chips .chip');
      let currentFilter = 'all';
      function apply(){
        const q = (search?.value || '').toLowerCase();
        document.querySelectorAll('#catalog-grid [data-type]').forEach(function(card){
          const t = card.getAttribute('data-type');
          const s = card.getAttribute('data-search') || '';
          const okType = currentFilter === 'all' || currentFilter === t;
          const okSearch = !q || s.includes(q);
          card.style.display = okType && okSearch ? '' : 'none';
        });
      }
      search?.addEventListener('input', apply);
      chips.forEach(function(c){
        c.addEventListener('click', function(){
          chips.forEach(function(x){ x.classList.remove('active'); });
          c.classList.add('active');
          currentFilter = c.getAttribute('data-filter');
          apply();
        });
      });
    })();
    </script>
    {{/inline}}
{{/layout}}
