{{#> layout}}
    {{#*inline "content"}}
    {{> components/page-header title=title subtitle=subtitle}}

    <section class="sp-demo-skills__kpis" aria-label="Skill adoption headline">
        {{#each kpis}}
        {{> components/stat-card label=label value=value variant=variant testid=testid}}
        {{/each}}
    </section>

    {{> components/timeseries-chart chart}}

    {{> components/tabs tabs=tabs nav_label="Skill adoption views"}}

    {{#if is_by_skill}}
    <section class="sp-demo-skills__panel" aria-label="By skill">
        {{#if has_skills}}
        {{#> components/data-table}}
            <thead><tr>
                <th>Plugin</th>
                <th>Skill</th>
                <th>Source</th>
                <th class="sp-u-num sp-table__cell--num">Invocations</th>
                <th class="sp-u-num sp-table__cell--num">Users</th>
                <th class="sp-u-num sp-table__cell--num">Requests</th>
                <th class="sp-u-num sp-table__cell--num">Tokens</th>
                <th class="sp-u-num sp-table__cell--num">Cost</th>
                <th class="sp-col-date">Last used</th>
            </tr></thead>
            <tbody>
            {{#each skills}}
            <tr>
                <td>{{#if plugin}}<span class="sp-badge sp-badge--muted">{{plugin}}</span>{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
                <td>
                    <code class="sp-code-inline">{{skill}}</code>
                    {{#if is_retired}}<span class="sp-badge sp-badge--muted" title="No skill of this name is configured any more; the invocation was real when it was recorded.">retired</span>{{/if}}
                </td>
                <td class="sp-u-text-tertiary sp-u-text-xs">{{source_label}}</td>
                <td class="sp-u-num">{{formatNumber invocation_count}}</td>
                <td class="sp-u-num">{{formatNumber distinct_users}}</td>
                <td class="sp-u-num">{{formatNumber request_count}}</td>
                <td class="sp-u-num">{{tokens_display}}</td>
                <td class="sp-u-num">{{cost_display}}</td>
                <td class="sp-col-date">
                    {{#if last_used_at}}<span title="{{formatDate last_used_at}}">{{relativeTime last_used_at}}</span>
                    {{else}}<span class="sp-u-text-tertiary">Never</span>{{/if}}
                </td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/data-table}}
        <p class="sp-demo-skills__note">{{attribution_note}}</p>
        {{else}}
        {{> components/empty-state message="No skill invocations recorded yet."}}
        {{/if}}
    </section>
    {{/if}}

    {{#if is_by_user}}
    <section class="sp-demo-skills__panel" aria-label="Who ran what">
        <h2 class="sp-section__title">Who ran what</h2>
        {{#if matrix.has_data}}
        <div class="sp-demo-matrix">
            <table class="sp-demo-matrix__table">
                <thead><tr>
                    <th scope="col">User</th>
                    {{#each matrix.columns}}<th scope="col" title="{{this.full}}">{{this.label}}</th>{{/each}}
                    <th scope="col" class="sp-u-num">Total</th>
                </tr></thead>
                <tbody>
                {{#each matrix.rows}}
                <tr>
                    <th scope="row">{{user_email}}</th>
                    {{#each cells}}
                    <td class="sp-demo-matrix__cell{{#if is_zero}} sp-demo-matrix__cell--empty{{/if}}" style="--v:{{pct}}%">{{count}}</td>
                    {{/each}}
                    <td class="sp-u-num">{{formatNumber total}}</td>
                </tr>
                {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        {{> components/empty-state message="No per-user skill activity in this window."}}
        {{/if}}
    </section>

    <section class="sp-demo-skills__panel" aria-label="Per-user totals">
        <h2 class="sp-section__title">Per-user totals</h2>
        {{#if has_user_totals}}
        {{#> components/data-table}}
            <thead><tr>
                <th>User</th>
                <th class="sp-u-num sp-table__cell--num">Invocations</th>
                <th class="sp-u-num sp-table__cell--num">Tokens</th>
                <th class="sp-u-num sp-table__cell--num">Cost</th>
            </tr></thead>
            <tbody>
            {{#each user_totals}}
            <tr>
                <td>{{user_email}}</td>
                <td class="sp-u-num">{{formatNumber total}}</td>
                <td class="sp-u-num">{{tokens_display}}</td>
                <td class="sp-u-num">{{cost_display}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/data-table}}
        {{else}}
        {{> components/empty-state message="No per-user skill activity in this window."}}
        {{/if}}
        <p class="sp-demo-skills__note">{{attribution_note}}</p>
    </section>
    {{/if}}
    {{/inline}}
{{/layout}}
