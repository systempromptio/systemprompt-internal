{{#> layout title=title page=page}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "content"}}
    {{> components/page-header title=title}}

    <!-- ===== Toolbar / source-of-truth ===== -->
    <div class="ac-toolbar" role="toolbar" aria-label="Access control toolbar">
        <div class="ac-search-group">
            <input type="search" class="search-input" id="ac-search"
                   placeholder="Search users, departments, entities…"
                   aria-label="Search">
        </div>
        <div class="ac-source-pill" data-tip="Bootstrap config is read from services/access-control/*.yaml on startup. Live edits are written to this instance's database only — they never get pushed back to the YAML or to git.">
            <strong>Bootstrap:</strong> services/access-control/*.yaml &nbsp;·&nbsp;
            <strong>Runtime edits:</strong> this instance's database
        </div>
        <button type="button" class="btn btn-secondary" id="ac-show-yaml">
            Show as YAML
        </button>
        <button type="button" class="btn btn-secondary" id="ac-new-department">
            + New department
        </button>
    </div>

    <div class="ac-stats">
        <span><strong>{{stats.department_count}}</strong> department{{#unless (eq stats.department_count 1)}}s{{/unless}}</span>
        <span>·</span>
        <span><strong>{{stats.user_count}}</strong> users</span>
    </div>

    <!-- ===== Three-pane layout ===== -->
    <div class="ac-layout">
        <!-- Left: department tree -->
        <aside class="ac-tree" aria-label="Departments and users">
            <h3 class="ac-tree-heading">Departments</h3>
            {{#each departments}}
            <div class="ac-tree-dept" data-dept="{{name}}">
                <button type="button" class="ac-dept-row" data-action="select-dept" data-dept="{{name}}">
                    <span class="ac-dept-name">{{name}}</span>
                    <span class="ac-dept-count">{{user_count}}</span>
                </button>
                <ul class="ac-dept-users" role="list">
                    {{#each users}}
                    <li>
                        <button type="button" class="ac-user-row {{#unless is_active}}is-inactive{{/unless}}"
                                data-action="select-user"
                                data-user-id="{{id}}"
                                data-user-display="{{display_name}}"
                                data-user-email="{{email}}">
                            <span class="ac-user-name">{{display_name}}</span>
                            <span class="ac-user-roles">
                                {{#each roles}}<span class="ac-role-chip">{{this}}</span>{{/each}}
                            </span>
                        </button>
                    </li>
                    {{/each}}
                </ul>
            </div>
            {{/each}}
        </aside>

        <!-- Center pane: switches between welcome / dept editor / user matrix -->
        <section class="ac-detail" id="ac-detail" aria-live="polite">
            <div class="ac-welcome" id="ac-welcome">
                <h3 class="ac-welcome-title">Nothing selected yet</h3>
                <p>Pick a department to assign access at the group level, or pick a user to see their full permission matrix.</p>
                <details class="ac-welcome-tips-wrap">
                    <summary>How changes are stored</summary>
                    <ul class="ac-welcome-tips">
                        <li><strong>Bootstrap config comes from YAML.</strong> Edits made here apply to this instance only.</li>
                        <li>Use <em>Show as YAML</em> to copy the current state as a snippet you can commit back to the source repo.</li>
                    </ul>
                </details>
            </div>

            <!-- Department editor (rendered by JS) -->
            <div class="ac-dept-editor" id="ac-dept-editor" hidden></div>

            <!-- User permission matrix (rendered by JS) -->
            <div class="ac-user-matrix" id="ac-user-matrix" hidden></div>
        </section>
    </div>

    <!-- ===== Modal overlay shells ===== -->
    <div class="panel-overlay" id="ac-modal-overlay" hidden></div>
    <div class="ac-modal" id="ac-yaml-modal" role="dialog" aria-modal="true" aria-labelledby="ac-yaml-title" tabindex="-1" hidden>
        <div class="ac-modal-header">
            <h2 id="ac-yaml-title">Current state as YAML</h2>
            <button type="button" class="panel-close" id="ac-yaml-close" aria-label="Close">&times;</button>
        </div>
        <div class="ac-modal-body">
            <p class="ac-modal-hint">
                This is the current database state of role/department rules on this instance,
                rendered in the loader's YAML schema. Copy any rules you want to make
                permanent into <code>services/access-control/*.yaml</code> in the source repo
                and redeploy. Per-user overrides are intentionally excluded.
            </p>
            <pre class="ac-yaml-pre" id="ac-yaml-content">Loading…</pre>
            <div class="ac-modal-actions">
                <button type="button" class="btn btn-secondary" id="ac-yaml-copy">Copy</button>
            </div>
        </div>
    </div>

    <div class="ac-modal" id="ac-new-dept-modal" role="dialog" aria-modal="true" aria-labelledby="ac-new-dept-title" tabindex="-1" hidden>
        <div class="ac-modal-header">
            <h2 id="ac-new-dept-title">Create department</h2>
            <button type="button" class="panel-close" id="ac-new-dept-close" aria-label="Close">&times;</button>
        </div>
        <div class="ac-modal-body">
            <label class="ac-field">
                <span>Name</span>
                <input type="text" id="ac-new-dept-name" class="search-input" placeholder="e.g. Engineering" autocomplete="off" maxlength="64">
            </label>
            <label class="ac-field">
                <span>Description (optional)</span>
                <input type="text" id="ac-new-dept-desc" class="search-input" autocomplete="off">
            </label>
            <p class="ac-form-error" id="ac-new-dept-error" hidden></p>
            <p class="ac-modal-hint">
                Saving creates the department in this instance's database.
                Users you have not assigned anywhere sit in <strong>Default</strong>.
                To make a department part of the bootstrap baseline, add it to
                <code>services/access-control/departments.yaml</code> in the source repo.
            </p>
            <div class="ac-modal-actions">
                <button type="button" class="btn btn-primary" id="ac-new-dept-save">Create</button>
                <button type="button" class="btn btn-secondary" id="ac-new-dept-cancel">Cancel</button>
            </div>
        </div>
    </div>

    <!-- ===== Render templates cloned by the JS controller ===== -->
    <template id="ac-tpl-dept-editor">
        <div>
            <div class="ac-user-header">
                <h2 data-slot="name"></h2>
                <div class="ac-user-meta">Department editor · changes save to this instance's database</div>
            </div>
            <p>Toggle access for the whole department here. To make a rule permanent across deployments, copy it into <code>services/access-control/departments.yaml</code> in the source repo.</p>
            <div data-slot="sections"></div>
        </div>
    </template>
    <template id="ac-tpl-dept-unselected">
        <p><em>Pick a department from the tree to manage its access.</em></p>
    </template>
    <template id="ac-tpl-dept-section">
        <div class="ac-section">
            <h3 data-slot="label"></h3>
            <div class="ac-dept-rule-list" data-slot="rules"></div>
        </div>
    </template>
    <template id="ac-tpl-dept-rule-empty">
        <div class="ac-dept-rule"><em>No entities of this type configured.</em></div>
    </template>
    <template id="ac-tpl-dept-rule">
        <div class="ac-dept-rule">
            <span class="ac-matrix-entity"><span data-slot="label"></span><span class="id" data-slot="id"></span></span>
            <span class="ac-source">—</span>
            <select data-action="dept-rule-access">
                <option value="inherit">inherit</option>
                <option value="allow">allow</option>
                <option value="deny">deny</option>
            </select>
            <span></span>
        </div>
    </template>
    <template id="ac-tpl-matrix-loading">
        <p>Loading matrix for <strong data-slot="name"></strong>…</p>
    </template>
    <template id="ac-tpl-matrix-error">
        <p class="error">Failed to load the permission matrix for this user.</p>
    </template>
    <template id="ac-tpl-matrix">
        <div>
            <div class="ac-user-header">
                <h2 data-slot="name"></h2>
                <div class="ac-user-meta">
                    <span data-slot="email"></span>
                    <span>·</span>
                    <span data-slot="roles"></span>
                    <span>·</span>
                    <label>department:
                        <select data-action="assign-dept" aria-label="Assign department"></select>
                    </label>
                </div>
            </div>
            <p>Per-user overrides are saved to this instance's database only and are intentionally never written back to YAML.</p>
            <div data-slot="sections"></div>
        </div>
    </template>
    <template id="ac-tpl-matrix-section">
        <div class="ac-matrix-section">
            <div class="ac-matrix-section-header"><span data-slot="label"></span><span data-slot="count"></span></div>
        </div>
    </template>
    <template id="ac-tpl-matrix-empty">
        <div class="ac-matrix-row"><em>No entities of this type configured.</em></div>
    </template>
    <template id="ac-tpl-matrix-row">
        <div class="ac-matrix-row">
            <div class="ac-matrix-entity"><span data-slot="name"></span><span class="id" data-slot="id"></span></div>
            <div class="ac-effective" data-slot="effective"></div>
            <div class="ac-source">
                <span class="ac-layer-tag" data-slot="layer"></span>
                <span data-slot="detail"></span>
            </div>
            <div class="ac-override">
                <button type="button" class="is-allow" data-override="allow">Allow</button>
                <button type="button" class="is-deny" data-override="deny">Deny</button>
                <button type="button" class="is-inherit" data-override="inherit">Inherit</button>
            </div>
        </div>
    </template>

    <!-- Embedded data for the JS controller. -->
    <script type="application/json" id="ac-entity-catalogue">{{{json entity_catalogue}}}</script>
    <script type="application/json" id="ac-known-roles">{{{json known_roles}}}</script>
    <script type="application/json" id="ac-departments">{{{json department_names}}}</script>

    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/pages/admin-access-control.js"></script>
    {{/inline}}
{{/layout}}
