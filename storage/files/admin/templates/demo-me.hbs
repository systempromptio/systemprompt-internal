{{#> layout}}
    {{#*inline "content"}}
    {{> components/page-header title=title subtitle=subtitle}}

    <p class="sp-u-text-secondary">
        Signed in as <strong data-testid="demo-me-email">{{user_email}}</strong>.
        This page is scoped to you and takes no user filter.
    </p>

    <section class="sp-kpi-grid" aria-label="My demo KPIs">
        {{#each kpis}}
        {{> components/stat-card label=label value=value variant=variant testid=testid}}
        {{/each}}
    </section>

    {{> components/timeseries-chart chart}}
    {{> components/timeseries-chart tool_chart}}

    <section aria-label="My skills">
        <h2 class="sp-section__title">Skills you ran</h2>
        {{#if has_skills}}
        {{#> components/data-table}}
            <thead><tr>
                <th>Plugin</th>
                <th>Skill</th>
                <th class="sp-u-num sp-table__cell--num">Invocations</th>
                <th class="sp-u-num sp-table__cell--num">Requests</th>
                <th class="sp-u-num sp-table__cell--num">Tokens</th>
                <th class="sp-u-num sp-table__cell--num">Cost</th>
                <th class="sp-col-date">Last used</th>
            </tr></thead>
            <tbody>
            {{#each skills}}
            <tr>
                <td>{{#if plugin}}<span class="sp-badge sp-badge--muted">{{plugin}}</span>{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
                <td><code class="sp-code-inline">{{skill}}</code></td>
                <td class="sp-u-num">{{formatNumber invocation_count}}</td>
                <td class="sp-u-num">{{formatNumber request_count}}</td>
                <td class="sp-u-num">{{tokens_display}}</td>
                <td class="sp-u-num">{{cost_display}}</td>
                <td class="sp-col-date">
                    {{#if last_used_at}}<span title="{{formatDate last_used_at}}">{{relativeTime last_used_at}}</span>
                    {{else}}<span class="sp-u-text-tertiary">Never</span>{{/if}}
                </td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/data-table}}
        {{else}}
        {{> components/empty-state message="You have not run a skill yet. Start a Claude Code session against this instance and it appears here."}}
        {{/if}}
    </section>

    <section aria-label="My MCP tools">
        <h2 class="sp-section__title">MCP tools you called</h2>
        {{#if has_tools}}
        {{#> components/data-table}}
            <thead><tr>
                <th>Server</th>
                <th>Tool</th>
                <th class="sp-u-num sp-table__cell--num">Calls</th>
                <th class="sp-u-num sp-table__cell--num">Failed</th>
                <th class="sp-u-num sp-table__cell--num">Denied</th>
                <th class="sp-u-num sp-table__cell--num">Held</th>
                <th class="sp-u-num sp-table__cell--num">Tokens</th>
                <th class="sp-u-num sp-table__cell--num">Cost</th>
            </tr></thead>
            <tbody>
            {{#each tools}}
            <tr>
                <td><span class="sp-badge sp-badge--muted">{{server}}</span></td>
                <td><code class="sp-code-inline">{{tool}}</code></td>
                <td class="sp-u-num">{{formatNumber call_count}}</td>
                <td class="sp-u-num">{{formatNumber failure_count}}</td>
                <td class="sp-u-num">{{formatNumber denied}}</td>
                <td class="sp-u-num">{{formatNumber held}}</td>
                <td class="sp-u-num">{{tokens_display}}</td>
                <td class="sp-u-num">{{cost_display}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/data-table}}
        {{else}}
        {{> components/empty-state message="You have not called an MCP tool yet."}}
        {{/if}}
    </section>

    <section aria-label="My logbook">
        <h2 class="sp-section__title">Your logbook</h2>
        {{#if has_rows}}
        {{#> components/data-table}}
            <thead><tr>
                <th class="sp-col-date">Time</th>
                <th class="sp-col-status">Kind</th>
                <th>What</th>
                <th>Detail</th>
                <th class="sp-col-status">Outcome</th>
                <th>Policy</th>
            </tr></thead>
            <tbody>
            {{#each rows}}
            <tr>
                <td class="sp-col-date"><span title="{{formatDate at}}">{{relativeTime at}}</span></td>
                <td class="sp-col-status"><span class="sp-badge sp-badge--muted">{{kind_label}}</span></td>
                <td><code class="sp-code-inline">{{label}}</code></td>
                <td>{{#if detail}}{{detail}}{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
                <td class="sp-col-status">
                    {{#if status}}{{> components/badge color=status_color text=status}}
                    {{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}
                </td>
                <td>{{#if policy}}<code class="sp-code-inline">{{policy}}</code>{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/data-table}}
        {{else}}
        {{> components/empty-state message="Nothing recorded for you yet."}}
        {{/if}}
        <p class="sp-u-text-tertiary sp-u-text-xs sp-u-mt-3">{{attribution_note}}</p>
    </section>
    {{/inline}}
{{/layout}}
