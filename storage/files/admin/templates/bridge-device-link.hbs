<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <title>{{branding.domain}} — Authorise device</title>
    <link rel="stylesheet" href="/css/core/fonts.css?v={{css_version}}">
    <link rel="stylesheet" href="/css/admin-bundle.css?v={{css_version}}">
</head>
<body>
    <div class="login-container">
        <div class="card">
            <div class="login-logo"><img src="/files/images/logo-white.svg" alt="{{branding.domain}}" height="40"></div>
            <h1 class="text-xl mb-2">Link this computer</h1>
            <p class="text-sm text-tertiary mb-1">
                {{#if redirect_host}}A local helper at <strong class="text-primary">{{redirect_host}}</strong>{{else}}A command-line helper on another machine{{/if}}
                will sign in as the account below.
            </p>
            <div class="device-link-identity mb-3">
                <div class="text-base text-primary"><strong>{{account_email}}</strong></div>
                {{#if account_name}}<div class="text-sm text-tertiary">{{account_name}}</div>{{/if}}
                {{#if signed_in_via}}<div class="text-sm text-tertiary">Signed in via {{signed_in_via}}</div>{{/if}}
                <a class="text-sm" href="{{switch_account_href}}">Not you? Use a different account</a>
            </div>
            {{#if email_mismatch}}
            <div class="device-link-mismatch mb-3">
                <strong>Check this before you continue.</strong>
                Your browser session says <strong>{{session_email}}</strong>, but this platform
                account is <strong>{{account_email}}</strong>. The token will be issued to
                <strong>{{account_email}}</strong>. If that is not the account you meant, use
                &ldquo;Not you?&rdquo; above and sign in again.
            </div>
            {{/if}}
            <p class="text-sm text-tertiary mb-4">
                Only approve if you started <code>{{#if redirect_host}}sp-bridge-auth{{else}}systemprompt-internal-bridge login{{/if}}</code> yourself. The helper will receive a one-time code (valid for {{code_ttl_seconds}}&nbsp;seconds) and exchange it for a durable personal access token that signs in as you until you revoke it.
            </p>

            <div class="form-actions device-link-actions">
                <form method="POST" action="/bridge-auth/device-link/approve" class="device-link-form">
                    {{#if redirect}}<input type="hidden" name="redirect" value="{{redirect}}">{{/if}}
                    <input type="hidden" name="confirm_account" value="{{account_email}}">
                    <button type="submit" class="btn btn-primary w-full">Allow</button>
                </form>
                <form method="POST" action="/bridge-auth/device-link/deny" class="device-link-form">
                    {{#if redirect}}<input type="hidden" name="redirect" value="{{redirect}}">{{/if}}
                    <button type="submit" class="btn btn-secondary w-full">Deny</button>
                </form>
            </div>

            <p class="text-xs text-tertiary mt-3 text-center">
                Didn't start this? Click Deny and review your active tokens on
                <a href="/admin/profile">your profile</a>.
            </p>
        </div>
    </div>
</body>
</html>
