{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/page-header
        title="Evals"
        subtitle="What went through the gateway, and whether the answers were any good."}}

    {{> components/time-range time_range}}

    {{#if time_range.auto_widened}}
    <p class="audit-toolbar__notice text-muted text-xs">
        No inference requests in the last 24h — auto-widened to last {{time_range.auto_widened}}.
    </p>
    {{/if}}

    {{#if notice}}
    <p class="eval-notice{{#if notice.is_error}} eval-notice--error{{/if}}" role="status">
        {{notice.message}}
    </p>
    {{/if}}

    {{> evals/tabs}}

    {{#if show_traffic_kpis}}{{> evals/kpi-traffic}}{{/if}}
    {{#if show_quality_kpis}}{{> evals/kpi-quality}}{{/if}}

    {{#if is_overview}}{{> evals/overview}}{{/if}}
    {{#if is_traffic}}{{> evals/traffic}}{{/if}}
    {{#if is_judge}}{{> evals/judge}}{{/if}}
    {{#if is_head_to_head}}{{> evals/head-to-head}}{{/if}}
    {{#if is_golden_set}}{{> evals/golden-set}}{{/if}}

    {{/inline}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "scripts"}}{{/inline}}
{{/layout}}
