{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/page-header
        title="Evals"
        subtitle="What went through the gateway, and whether the answers were any good."}}

    {{> components/time-range time_range}}

    {{#if time_range.auto_widened}}
    <p class="audit-toolbar__notice text-muted text-xs">
        No inference requests in the last 24h — auto-widened to last {{time_range.auto_widened}}.
    </p>
    {{/if}}

    {{#if notice}}
    <p class="eval-notice{{#if notice.is_error}} eval-notice--error{{/if}}" role="status">
        {{notice.message}}
    </p>
    {{/if}}

    <section class="kpi-strip" aria-label="Traffic and score KPIs">
        <div class="kpi-card">
            <span class="kpi-card__label">Requests</span>
            <span class="kpi-card__value">{{traffic.total}}</span>
            <span class="kpi-card__sub">{{traffic.user_count}} users · {{traffic.model_count}} models</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-card__label">Mean score</span>
            <span class="kpi-card__value">{{scores.mean_score_display}}</span>
            <span class="kpi-card__sub">{{scores.scored_count}} judged · {{scores.coverage_pct}}% coverage</span>
        </div>
        <div class="kpi-card{{#if scores.fail_count}} kpi-card--danger{{/if}}">
            <span class="kpi-card__label">Verdicts</span>
            <span class="kpi-card__value">{{scores.pass_count}} / {{scores.partial_count}} / {{scores.fail_count}}</span>
            <span class="kpi-card__sub">pass / partial / fail</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-card__label">p50 latency</span>
            <span class="kpi-card__value">{{traffic.p50_latency_ms}} ms</span>
            <span class="kpi-card__sub">p95 {{traffic.p95_latency_ms}} ms</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-card__label">Traffic cost</span>
            <span class="kpi-card__value">{{traffic.total_cost_display}}</span>
            <span class="kpi-card__sub">judging {{scores.judge_cost_display}}</span>
        </div>
        <div class="kpi-card{{#if traffic.error_count}} kpi-card--danger{{/if}}">
            <span class="kpi-card__label">Errors</span>
            <span class="kpi-card__value">{{traffic.error_count}}</span>
            <span class="kpi-card__sub">{{traffic.error_rate_pct}}%</span>
        </div>
    </section>

    <div class="requests-charts">
        <section class="requests-charts__panel">
            <h3 class="requests-charts__title">Latency distribution</h3>
            <div class="latency-histogram" data-histogram-max="{{histogram_max}}">
                {{#each histogram}}
                <div class="latency-histogram__bar" data-count="{{this.count}}"
                     style="--v:{{this.pct}}%"
                     title="{{this.label}}: {{this.count}} requests">
                    <span class="latency-histogram__count">{{this.count}}</span>
                    <span class="latency-histogram__label">{{this.label}}</span>
                </div>
                {{/each}}
            </div>
        </section>

        <section class="requests-charts__panel">
            <h3 class="requests-charts__title">Cost over time</h3>
            <div class="cost-spark" data-cost-max="{{cost_max}}"
                 aria-label="Cost time series, 24 buckets">
                {{#each cost_series}}
                <div class="cost-spark__bar" data-cost="{{this.cost_microdollars}}"
                     style="--v:{{this.pct}}%"
                     title="{{this.bucket_start}}: {{formatUsd this.cost_microdollars}}"></div>
                {{/each}}
            </div>
        </section>
    </div>

    <h2 class="eval-section-title">Distribution</h2>

    {{#if models}}
    <h3 class="eval-subsection-title">By model</h3>
    {{#> components/data-table}}
        <thead><tr>
            <th>Model</th>
            <th class="col-num">Requests</th>
            <th class="col-num">Users</th>
            <th class="col-num">Tokens</th>
            <th class="col-num">Cost</th>
            <th class="col-num">Cost / req</th>
            <th class="col-num">p50 / p95</th>
            <th class="col-num">Errors</th>
            <th class="col-num">Mean score</th>
        </tr></thead>
        <tbody>
        {{#each models}}
        <tr>
            <td>
                <code class="code-inline">{{this.model}}</code>
                <span class="text-muted text-xs">{{this.provider}}</span>
            </td>
            <td class="col-num">
                <div class="eval-share" title="{{this.share_pct}}% of requests">
                    <span class="eval-share__count">{{this.request_count}}</span>
                    <span class="eval-share__bar" style="--v:{{this.share_pct}}%"></span>
                </div>
            </td>
            <td class="col-num">{{this.user_count}}</td>
            <td class="col-num">{{this.tokens_total}}</td>
            <td class="col-num">{{this.cost_display}}</td>
            <td class="col-num">{{this.cost_per_request_display}}</td>
            <td class="col-num">{{this.p50_latency_ms}} / {{this.p95_latency_ms}} ms</td>
            <td class="col-num">
                {{#if this.error_count}}
                  <span class="mcp-badge mcp-badge-danger">{{this.error_count}}</span>
                {{else}}—{{/if}}
            </td>
            <td class="col-num">
                {{#if this.has_score}}
                  <span class="eval-score" title="{{this.scored_count}} judged, {{this.fail_count}} failing">
                    {{this.mean_score_display}}
                  </span>
                {{else}}<span class="text-muted">not judged</span>{{/if}}
            </td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/data-table}}
    {{/if}}

    {{#if users}}
    <h3 class="eval-subsection-title">By user</h3>
    {{#> components/data-table}}
        <thead><tr>
            <th>User</th>
            <th class="col-num">Requests</th>
            <th class="col-num">Sessions</th>
            <th class="col-num">Models</th>
            <th class="col-num">Errors</th>
            <th class="col-num">Cost</th>
            <th class="col-date">Last seen</th>
        </tr></thead>
        <tbody>
        {{#each users}}
        <tr>
            <td><a href="/admin/user?id={{this.user_id}}">{{truncate this.user_label 24}}</a></td>
            <td class="col-num">
                <div class="eval-share" title="{{this.share_pct}}% of requests">
                    <span class="eval-share__count">{{this.request_count}}</span>
                    <span class="eval-share__bar" style="--v:{{this.share_pct}}%"></span>
                </div>
            </td>
            <td class="col-num">{{this.session_count}}</td>
            <td class="col-num">{{this.model_count}}</td>
            <td class="col-num">{{#if this.error_count}}{{this.error_count}}{{else}}—{{/if}}</td>
            <td class="col-num">{{this.cost_display}}</td>
            <td class="col-date">{{this.last_seen_local}}</td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/data-table}}
    {{/if}}

    {{#if topics}}
    <h3 class="eval-subsection-title">Prompt shapes</h3>
    <p class="text-muted text-xs eval-hint">
        Grouped on the opening words of each stored prompt. A distribution hint, not a classifier.
    </p>
    {{#> components/data-table}}
        <thead><tr>
            <th>Opening</th>
            <th class="col-num">Requests</th>
            <th class="col-num">Models</th>
            <th class="col-num">Cost</th>
        </tr></thead>
        <tbody>
        {{#each topics}}
        <tr>
            <td>
                <span class="eval-topic">{{this.topic}}</span>
                <span class="text-muted text-xs eval-topic__sample">{{this.sample_excerpt}}</span>
            </td>
            <td class="col-num">
                <div class="eval-share" title="{{this.share_pct}}% of requests">
                    <span class="eval-share__count">{{this.request_count}}</span>
                    <span class="eval-share__bar" style="--v:{{this.share_pct}}%"></span>
                </div>
            </td>
            <td class="col-num">{{this.distinct_models}}</td>
            <td class="col-num">{{this.cost_display}}</td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/data-table}}
    {{/if}}

    <h2 class="eval-section-title">Run an evaluation</h2>
    <p class="text-muted text-xs eval-hint">
        Judge calls go out through this gateway under your own session, so they are
        scope-checked, audited and costed like any other client's traffic — and are
        excluded from future sampling. Suggested judge: <code class="code-inline">{{judge_model}}</code>,
        the least-used model in this window, which is least likely to be grading its own output.
    </p>

    <div class="eval-run-forms">
        <form method="post" action="{{base_url}}/run" class="toolbar eval-run-form">
            <input type="hidden" name="kind" value="judge">
            <input type="hidden" name="from" value="{{time_range.from}}">
            <input type="hidden" name="to" value="{{time_range.to}}">
            <span class="eval-run-form__label">Judge live traffic</span>
            <label class="filter-field">
                <span class="filter-field__label">Sample size</span>
                <input type="number" name="sample_size" class="search-input eval-run-form__number"
                       value="{{default_sample_size}}" min="1" max="{{max_sample_size}}">
            </label>
            <label class="filter-field">
                <span class="filter-field__label">Judge model</span>
                <select name="judge_model" class="filter-select">
                    {{#each model_options}}
                    <option value="{{this.value}}">{{this.label}}</option>
                    {{/each}}
                </select>
            </label>
            <button type="submit" class="btn btn-sm">Run judge</button>
        </form>

        <form method="post" action="{{base_url}}/run" class="toolbar eval-run-form">
            <input type="hidden" name="kind" value="replay">
            <input type="hidden" name="from" value="{{time_range.from}}">
            <input type="hidden" name="to" value="{{time_range.to}}">
            <span class="eval-run-form__label">Replay golden set</span>
            <label class="filter-field">
                <span class="filter-field__label">Target model</span>
                <select name="model" class="filter-select">
                    {{#each model_options}}
                    <option value="{{this.value}}">{{this.label}}</option>
                    {{/each}}
                </select>
            </label>
            <label class="filter-field">
                <span class="filter-field__label">Judge model</span>
                <select name="judge_model" class="filter-select">
                    {{#each model_options}}
                    <option value="{{this.value}}">{{this.label}}</option>
                    {{/each}}
                </select>
            </label>
            <button type="submit" class="btn btn-sm"{{#unless cases}} disabled{{/unless}}>
                Run replay
            </button>
        </form>

        <form method="post" action="{{base_url}}/run" class="toolbar eval-run-form">
            <input type="hidden" name="kind" value="pairwise">
            <input type="hidden" name="from" value="{{time_range.from}}">
            <input type="hidden" name="to" value="{{time_range.to}}">
            <span class="eval-run-form__label">Compare two models</span>
            <label class="filter-field">
                <span class="filter-field__label">Model A</span>
                <select name="model_a" class="filter-select">
                    {{#each model_options}}
                    <option value="{{this.value}}">{{this.label}}</option>
                    {{/each}}
                </select>
            </label>
            <label class="filter-field">
                <span class="filter-field__label">Model B</span>
                <select name="model_b" class="filter-select">
                    {{#each model_options}}
                    <option value="{{this.value}}">{{this.label}}</option>
                    {{/each}}
                </select>
            </label>
            <label class="filter-field">
                <span class="filter-field__label">Judge model</span>
                <select name="judge_model" class="filter-select">
                    {{#each model_options}}
                    <option value="{{this.value}}">{{this.label}}</option>
                    {{/each}}
                </select>
            </label>
            <button type="submit" class="btn btn-sm"{{#unless cases}} disabled{{/unless}}>
                Run comparison
            </button>
        </form>
    </div>

    {{#unless cases}}
    <p class="text-muted text-xs eval-hint">
        Replay and comparison need a golden set. Add a case from any judged result below.
    </p>
    {{/unless}}

    {{#if win_rates}}
    <h3 class="eval-subsection-title">Head-to-head</h3>
    <p class="text-muted text-xs eval-hint">
        Every comparison is judged in both orders. Only an agreeing pair counts as a win;
        order-dependent verdicts are recorded as ties.
    </p>
    {{#> components/data-table}}
        <thead><tr>
            <th>Model</th>
            <th class="col-num">Comparisons</th>
            <th class="col-num">Wins</th>
            <th class="col-num">Losses</th>
            <th class="col-num">Ties</th>
            <th class="col-num">Win rate</th>
        </tr></thead>
        <tbody>
        {{#each win_rates}}
        <tr>
            <td><code class="code-inline">{{this.model}}</code></td>
            <td class="col-num">{{this.comparisons}}</td>
            <td class="col-num">{{this.wins}}</td>
            <td class="col-num">{{this.losses}}</td>
            <td class="col-num">{{this.ties}}</td>
            <td class="col-num">{{this.win_rate_pct}}%</td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/data-table}}
    {{/if}}

    {{#if runs}}
    <h3 class="eval-subsection-title">Recent runs</h3>
    {{#> components/data-table}}
        <thead><tr>
            <th>Run</th>
            <th>Kind</th>
            <th class="col-status">Status</th>
            <th>Judge</th>
            <th class="col-num">Scored</th>
            <th class="col-num">Failed</th>
            <th class="col-num">Mean</th>
            <th class="col-num">Judge cost</th>
            <th class="col-date">Started</th>
        </tr></thead>
        <tbody>
        {{#each runs}}
        <tr>
            <td><a href="{{this.detail_url}}"><code class="code-inline">{{this.short_id}}</code></a></td>
            <td>{{this.kind}}</td>
            <td class="col-status">
                {{#if this.is_failed}}
                  <span class="mcp-badge mcp-badge-danger">{{this.status}}</span>
                {{else}}{{#if this.is_running}}
                  <span class="mcp-badge mcp-badge-warning">{{this.status}}</span>
                {{else}}
                  <span class="mcp-badge mcp-badge-success">{{this.status}}</span>
                {{/if}}{{/if}}
            </td>
            <td><code class="code-inline">{{truncate this.judge_model 22}}</code></td>
            <td class="col-num">{{this.scored_count}} / {{this.sample_size}}</td>
            <td class="col-num">{{#if this.failed_count}}{{this.failed_count}}{{else}}—{{/if}}</td>
            <td class="col-num">{{this.mean_score_display}}</td>
            <td class="col-num">{{this.cost_display}}</td>
            <td class="col-date">{{this.created_at_local}}</td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/data-table}}
    {{/if}}

    <h2 class="eval-section-title">Scored answers</h2>
    {{#if results}}
    <p class="text-muted text-xs eval-hint">Worst verdicts first — a passing answer needs no attention.</p>
    <div class="eval-results">
        {{#each results}}
        <article class="eval-result{{#if this.is_fail}} eval-result--fail{{/if}}{{#if this.is_partial}} eval-result--partial{{/if}}">
            <header class="eval-result__head">
                <span class="eval-result__score">{{this.score_display}}</span>
                <span class="mcp-badge {{#if this.is_pass}}mcp-badge-success{{/if}}{{#if this.is_partial}}mcp-badge-warning{{/if}}{{#if this.is_fail}}mcp-badge-danger{{/if}}">
                    {{this.verdict}}
                </span>
                <code class="code-inline">{{this.model}}</code>
                {{#each this.flags}}
                <span class="eval-flag">{{this}}</span>
                {{/each}}
                <span class="gf-panel__spacer"></span>
                {{#if this.ai_request_id}}
                <a class="eval-result__link" href="/admin/entities/requests/{{this.ai_request_id}}">
                    full chain &rarr;
                </a>
                {{/if}}
                <span class="text-muted text-xs">{{this.created_at_local}}</span>
            </header>

            {{#if this.dimensions}}
            <div class="eval-dims">
                {{#each this.dimensions}}
                <div class="eval-dim" title="{{this.label}}: {{this.score}}/5">
                    <span class="eval-dim__label">{{this.label}}</span>
                    <span class="eval-dim__bar" style="--v:{{this.pct}}%"></span>
                    <span class="eval-dim__score">{{this.score}}</span>
                </div>
                {{/each}}
            </div>
            {{/if}}

            <p class="eval-result__rationale">{{this.rationale}}</p>

            <details class="eval-result__detail">
                <summary>Prompt and answer</summary>
                <p class="eval-result__excerpt"><strong>Prompt:</strong> {{this.prompt_excerpt}}</p>
                <p class="eval-result__excerpt"><strong>Answer:</strong> {{this.response_excerpt}}</p>
            </details>

            {{#if this.promote_id}}
            <form method="post" action="{{@root.base_url}}/cases" class="eval-result__promote">
                <input type="hidden" name="ai_request_id" value="{{this.promote_id}}">
                <input type="hidden" name="from" value="{{@root.time_range.from}}">
                <input type="hidden" name="to" value="{{@root.time_range.to}}">
                <input type="text" name="expectation" class="search-input"
                       placeholder="What a good answer must do (optional)">
                <button type="submit" class="btn btn-sm btn-outline">Add to golden set</button>
            </form>
            {{/if}}
        </article>
        {{/each}}
    </div>
    {{else}}
    {{> components/empty-state
        message="Nothing judged in this window yet. Run a judge evaluation above to score recent traffic."}}
    {{/if}}

    {{#if cases}}
    <h2 class="eval-section-title">Golden set</h2>
    {{#> components/data-table}}
        <thead><tr>
            <th>Case</th>
            <th>Baseline model</th>
            <th>Expectation</th>
            <th class="col-date">Added</th>
        </tr></thead>
        <tbody>
        {{#each cases}}
        <tr>
            <td>{{this.name}}</td>
            <td><code class="code-inline">{{this.baseline_model}}</code></td>
            <td>{{#if this.has_expectation}}{{this.expectation}}{{else}}<span class="text-muted">—</span>{{/if}}</td>
            <td class="col-date">{{this.created_at_local}}</td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/data-table}}
    {{/if}}

    {{/inline}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "scripts"}}{{/inline}}
{{/layout}}
