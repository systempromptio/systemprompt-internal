{{!--
  The sp-tabs strip. Every tab is a link, so a view is bookmarkable and the
  server renders only the active tab's body.

  Invoke as: {{> components/tabs tabs=tabs label="Request views"}}

  Inputs:
    tabs   [{label, href, is_active, count?}] — built by the handler
    label  the nav's accessible name
--}}
<nav class="sp-tabs" role="tablist" aria-label="{{label}}">
    {{#each tabs}}
    <a class="sp-tab{{#if this.is_active}} sp-tab--active{{/if}}" role="tab"
       aria-selected="{{#if this.is_active}}true{{else}}false{{/if}}"
       href="{{this.href}}">{{this.label}}{{#if this.count}}
        <span class="sp-tab-count">{{this.count}}</span>{{/if}}</a>
    {{/each}}
</nav>
