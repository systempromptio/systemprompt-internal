{{!--
  Summary tile. Pass `href` to make the whole tile a link — used where the
  number it shows is also a filter the reader can apply (e.g. "16 denied" →
  the 16 denied traces). `active` marks that filter as currently applied.
--}}
{{#if href}}
<a class="sp-kpi sp-kpi--link{{#if variant}} sp-kpi--{{variant}}{{/if}}{{#if active}} is-active{{/if}}"
   href="{{href}}"{{#if hint}} title="{{hint}}"{{/if}}>
    <div class="sp-kpi__label">{{label}}</div>
    <div class="sp-kpi__value"{{#if testid}} data-testid="{{testid}}"{{/if}}>{{value}}</div>
    {{#if subtitle}}<div class="sp-kpi__sub">{{subtitle}}</div>{{/if}}
</a>
{{else}}
<div class="sp-kpi{{#if variant}} sp-kpi--{{variant}}{{/if}}"{{#if hint}} title="{{hint}}"{{/if}}>
    <div class="sp-kpi__label">{{label}}</div>
    <div class="sp-kpi__value"{{#if testid}} data-testid="{{testid}}"{{/if}}>{{value}}</div>
    {{#if subtitle}}<div class="sp-kpi__sub">{{subtitle}}</div>{{/if}}
</div>
{{/if}}
