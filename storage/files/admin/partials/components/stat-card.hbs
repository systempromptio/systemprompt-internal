{{!--
  Summary tile. Pass `href` to make the whole tile a link — used where the
  number it shows is also a filter the reader can apply (e.g. "16 denied" →
  the 16 denied traces). `active` marks that filter as currently applied.
--}}
{{#if href}}
<a class="stat-card stat-card--link{{#if variant}} {{variant}}{{/if}}{{#if active}} is-active{{/if}}"
   href="{{href}}"{{#if hint}} title="{{hint}}"{{/if}}>
    <div class="label">{{label}}</div>
    <div class="value"{{#if testid}} data-testid="{{testid}}"{{/if}}>{{value}}</div>
    {{#if subtitle}}<div class="kpi-subtitle">{{subtitle}}</div>{{/if}}
</a>
{{else}}
<div class="stat-card{{#if variant}} {{variant}}{{/if}}"{{#if hint}} title="{{hint}}"{{/if}}>
    <div class="label">{{label}}</div>
    <div class="value"{{#if testid}} data-testid="{{testid}}"{{/if}}>{{value}}</div>
    {{#if subtitle}}<div class="kpi-subtitle">{{subtitle}}</div>{{/if}}
</div>
{{/if}}
