{{!--
  Traffic tab: what actually went through the gateway in this window, sliced
  three ways. Straight from `ai_requests` — no judge involved.
--}}
<h2 class="eval-section-title">By model</h2>
{{#if models}}
{{#> components/data-table}}
    <thead><tr>
        <th>Model</th>
        <th class="col-num">Requests</th>
        <th class="col-num">Users</th>
        <th class="col-num">Tokens</th>
        <th class="col-num">Cost</th>
        <th class="col-num">Cost / req</th>
        <th class="col-num">p50 / p95</th>
        <th class="col-num">Errors</th>
        <th class="col-num">Mean score</th>
    </tr></thead>
    <tbody>
    {{#each models}}
    <tr>
        <td>
            <code class="code-inline">{{this.model}}</code>
            <span class="text-muted text-xs">{{this.provider}}</span>
        </td>
        <td class="col-num">
            <div class="eval-share" title="{{this.share_pct}}% of requests">
                <span class="eval-share__count">{{this.request_count}}</span>
                <span class="eval-share__bar" style="--v:{{this.share_pct}}%"></span>
            </div>
        </td>
        <td class="col-num">{{this.user_count}}</td>
        <td class="col-num">{{this.tokens_total}}</td>
        <td class="col-num">{{this.cost_display}}</td>
        <td class="col-num">{{this.cost_per_request_display}}</td>
        <td class="col-num">{{this.p50_latency_ms}} / {{this.p95_latency_ms}} ms</td>
        <td class="col-num">
            {{#if this.error_count}}
              <span class="mcp-badge mcp-badge-danger">{{this.error_count}}</span>
            {{else}}—{{/if}}
        </td>
        <td class="col-num">
            {{#if this.has_score}}
              <span class="eval-score" title="{{this.scored_count}} judged, {{this.fail_count}} failing">
                {{this.mean_score_display}}
              </span>
            {{else}}<span class="text-muted">not judged</span>{{/if}}
        </td>
    </tr>
    {{/each}}
    </tbody>
{{/components/data-table}}
{{else}}
{{> components/empty-state message="No requests in this window."}}
{{/if}}

{{#if users}}
<h2 class="eval-section-title">By user</h2>
{{#> components/data-table}}
    <thead><tr>
        <th>User</th>
        <th class="col-num">Requests</th>
        <th class="col-num">Sessions</th>
        <th class="col-num">Models</th>
        <th class="col-num">Errors</th>
        <th class="col-num">Cost</th>
        <th class="col-date">Last seen</th>
    </tr></thead>
    <tbody>
    {{#each users}}
    <tr>
        <td><a href="/admin/user?id={{this.user_id}}">{{truncate this.user_label 24}}</a></td>
        <td class="col-num">
            <div class="eval-share" title="{{this.share_pct}}% of requests">
                <span class="eval-share__count">{{this.request_count}}</span>
                <span class="eval-share__bar" style="--v:{{this.share_pct}}%"></span>
            </div>
        </td>
        <td class="col-num">{{this.session_count}}</td>
        <td class="col-num">{{this.model_count}}</td>
        <td class="col-num">{{#if this.error_count}}{{this.error_count}}{{else}}—{{/if}}</td>
        <td class="col-num">{{this.cost_display}}</td>
        <td class="col-date">{{this.last_seen_local}}</td>
    </tr>
    {{/each}}
    </tbody>
{{/components/data-table}}
{{/if}}

{{#if topics}}
<h2 class="eval-section-title">Prompt shapes</h2>
<p class="text-muted text-xs eval-hint">
    Grouped on the opening words of each stored prompt. A distribution hint, not a classifier.
</p>
{{#> components/data-table}}
    <thead><tr>
        <th>Opening</th>
        <th class="col-num">Requests</th>
        <th class="col-num">Models</th>
        <th class="col-num">Cost</th>
    </tr></thead>
    <tbody>
    {{#each topics}}
    <tr>
        <td>
            <span class="eval-topic">{{this.topic}}</span>
            <span class="text-muted text-xs eval-topic__sample">{{this.sample_excerpt}}</span>
        </td>
        <td class="col-num">
            <div class="eval-share" title="{{this.share_pct}}% of requests">
                <span class="eval-share__count">{{this.request_count}}</span>
                <span class="eval-share__bar" style="--v:{{this.share_pct}}%"></span>
            </div>
        </td>
        <td class="col-num">{{this.distinct_models}}</td>
        <td class="col-num">{{this.cost_display}}</td>
    </tr>
    {{/each}}
    </tbody>
{{/components/data-table}}
{{/if}}
