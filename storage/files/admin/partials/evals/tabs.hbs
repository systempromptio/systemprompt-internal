{{!--
  Evals tab bar. Server-rendered links, not JS panels: each tab is its own GET
  so it can be bookmarked and only its own queries run.

  Invoke as: {{> evals/tabs}} from the Evals page context.
--}}
<nav class="sp-tabs" role="tablist" aria-label="Evals sections">
    {{#each tabs}}
    <a class="sp-tab{{#if this.is_active}} sp-tab--active{{/if}}" role="tab"
       aria-selected="{{#if this.is_active}}true{{else}}false{{/if}}"
       href="{{this.href}}">{{this.label}}</a>
    {{/each}}
</nav>
