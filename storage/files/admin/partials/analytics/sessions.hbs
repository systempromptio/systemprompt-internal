{{!--
  Sessions tab. Every number is what the gateway metered for one
  conversation, most expensive first; the client session it ran in is linked
  beside it when the client said which one.
--}}
<section aria-label="Conversation cost">
    {{> analytics/kpi-row tiles=sessions.kpis}}

    {{#> components/section title="Conversations" count=sessions.session_count
        note="Gateway-metered cost and tokens per conversation, most expensive first."}}
      {{#*inline "section_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/sessions">Session log</a>
      {{/inline}}
    {{/components/section}}

    {{#if sessions.has_rows}}
    {{#> components/table caption="Conversation cost, requests and tokens"
         pagination=sessions.pagination}}
        <thead><tr>
            <th scope="col">Conversation</th>
            <th scope="col">User</th>
            <th scope="col">Model</th>
            <th scope="col" class="sp-table__cell--num" aria-sort="descending">Cost</th>
            <th scope="col" class="sp-table__cell--spark">Share</th>
            <th scope="col" class="sp-table__cell--num">Requests</th>
            <th scope="col" class="sp-table__cell--num" title="Prompt tokens over completion tokens">Tokens</th>
            <th scope="col">Session</th>
            <th scope="col" class="sp-table__cell--date">Last request</th>
        </tr></thead>
        <tbody>
        {{#each sessions.rows}}
        <tr>
            <td class="sp-table__cell--mono sp-table__cell--primary sp-p-analytics__name">
                <a href="{{this.detail_url}}" title="{{this.context_id}}">{{this.context_short}}</a>
            </td>
            <td class="sp-p-analytics__name"><a href="{{this.user_url}}">{{this.user_id}}</a></td>
            <td class="sp-table__cell--mono">{{this.model_display}}</td>
            <td class="sp-table__cell--num sp-u-mono">{{this.cost_display}}</td>
            <td class="sp-table__cell--spark"><span class="sp-p-analytics__bar" style="--v:{{this.share_pct}}%"></span></td>
            <td class="sp-table__cell--num sp-u-num">{{this.requests_display}}</td>
            <td class="sp-table__cell--num sp-u-num"
                title="{{this.cache_display}} tokens served from cache">{{this.input_display}} <span class="sp-table__cell--muted">/ {{this.output_display}}</span></td>
            <td>{{#if this.session_url}}<a href="{{this.session_url}}">Open</a>{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
            <td class="sp-table__cell--date">{{this.updated_display}}</td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/table}}
    {{else}}
    {{> components/empty-state title="No conversations"
        message="No conversation had a gateway request in this window."}}
    {{/if}}
</section>
