  <div class="glass-panel">
    <div class="bento4">
      <div class="glass-tile gt hero">
        <div class="gt-k">{{hero.kicker}}</div>
        <div class="gt-dim">{{hero.dim}}</div>
        <div class="gt-big">{{hero.big}}</div>
        <div class="gt-p gt-p-lead">{{{inline hero.body}}}</div>
      </div>
      <div class="bento4-right">
        <div class="bento4-top">
{{#each top}}          <div class="glass-tile gt">
            <div class="gt-h">{{heading}}</div>
            <div class="gt-p">{{{inline body}}}</div>
          </div>
{{/each}}        </div>
        <div class="glass-tile gt">
          <div class="gt-h">{{wide.heading}}</div>
          <div class="gt-p">{{{inline wide.body}}}</div>
        </div>
      </div>
    </div>
  </div>
