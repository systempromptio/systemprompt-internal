#!/usr/bin/env bash
# Tracked pre-push hook. Enable with `just init-hooks` (sets core.hooksPath).
#
# Runs the static and lint preflight tiers (fmt, sqlx cache, source gates,
# clippy, doc-check, msrv-check). Tests are too slow for a push hook — hosted
# CI (.github/workflows/ci.yml + quality.yml) runs the full suites on every
# push and PR.
set -euo pipefail

# DISABLED: the lint tier's clippy run is a full workspace compile, which is a
# cold rebuild of everything under crates.io whenever the [patch.crates-io]
# blocks are toggled — minutes of waiting on every push, on a hook people then
# reach for --no-verify to escape. `just preflight` before merging is still the
# mandatory gate; this only stops it running unbidden on each push.
#
# Re-enable by uncommenting:
# echo "pre-push: running preflight-static + preflight-lint (skip with --no-verify)"
# just preflight-static preflight-lint

echo "pre-push: gates disabled — 'just preflight' locally, tests run in hosted CI."
