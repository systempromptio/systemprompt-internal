  "query": "\n        SELECT\n            COUNT(*)::BIGINT AS \"requests!\",\n            COALESCE(SUM(input_tokens), 0)::BIGINT AS \"tokens_in!\",\n            COALESCE(SUM(output_tokens), 0)::BIGINT AS \"tokens_out!\",\n            MAX(created_at) AS \"last_request_at?\"\n        FROM ai_requests WHERE user_id = $1\n        ",
