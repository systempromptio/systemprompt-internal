  "query": "SELECT\n            model AS \"model!\",\n            COUNT(*)::bigint AS \"scored_count!\",\n            COALESCE(AVG(overall_score), 0)::float8 AS \"mean_score!\",\n            COUNT(*) FILTER (WHERE verdict = 'fail')::bigint AS \"fail_count!\"\n          FROM eval_results\n          WHERE created_at >= $1 AND created_at < $2\n          GROUP BY model",
