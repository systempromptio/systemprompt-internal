{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                title,\n                source,\n                project,\n                created_at,\n                char_length(content) AS \"size!\"\n            FROM knowledge_documents\n            WHERE ($1::text IS NULL OR project = $1)\n              AND ($2::text IS NULL OR source = $2)\n            ORDER BY created_at DESC\n            LIMIT $3\n            ",
