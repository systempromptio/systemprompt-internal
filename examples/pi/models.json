{
  "providers": {
    "systemprompt": {
      "baseUrl": "http://127.0.0.1:8099",
      "api": "anthropic-messages",
      "apiKey": "!cat ~/.config/systemprompt-pi/token",
      "headers": {
        "x-session-id": "!cat ~/.config/systemprompt-pi/session-id"
      },
      "models": [
        {
          "id": "claude-sonnet-4-6",
          "name": "Claude Sonnet 4.6 (Enterprise Demo gateway)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 200000,
          "maxTokens": 32000
        },
        {
          "id": "claude-opus-4-8",
          "name": "Claude Opus 4.8 (Enterprise Demo gateway)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 200000,
          "maxTokens": 32000
        },
        {
          "id": "gpt-5-mini",
          "name": "GPT-5 mini (Enterprise Demo gateway)",
          "input": ["text"],
          "contextWindow": 128000,
          "maxTokens": 16384
        },
        {
          "id": "gemini-2.5-flash",
          "name": "Gemini 2.5 Flash (Enterprise Demo gateway)",
          "input": ["text"],
          "contextWindow": 128000,
          "maxTokens": 16384
        }
      ]
    }
  }
}
